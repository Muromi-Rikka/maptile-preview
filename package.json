{
  "name": "maptile-preview",
  "type": "module",
  "version": "1.1.5",
  "packageManager": "pnpm@10.30.0",
  "description": "A modern, responsive web application for previewing and managing map tile sources with support for multiple coordinate systems and map providers",
  "author": {
    "email": "admin@rikka.cc",
    "name": "Rikka",
    "url": "https://github.com/Muromi-Rikka"
  },
  "license": "MIT",
  "homepage": "https://github.com/Muromi-Rikka/maptile-preview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muromi-Rikka/maptile-preview.git"
  },
  "bugs": {
    "url": "https://github.com/Muromi-Rikka/maptile-preview/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "map",
    "tiles",
    "maplibre-gl",
    "mapbox",
    "gis",
    "mapping",
    "tailwind",
    "rsbuild"
  ],
  "main": "dist/index.html",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.18.1",
    "pnpm": ">=10.30.0"
  },
  "scripts": {
    "dev": "rsbuild dev --open",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "lint": "eslint . --cache --max-warnings=0 --no-warn-ignored",
    "lint:fix": "eslint . --cache --fix --max-warnings=0 --no-warn-ignored",
    "postinstall": "husky",
    "docker:build": "docker build -t maptile-preview .",
    "docker:run": "docker run -p 80:80 --name maptile-preview maptile-preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "destr": "^2.0.5",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^6.1.0",
    "ofetch": "^1.5.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-map-gl": "^8.1.2",
    "react-use": "^17.6.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@rsbuild/core": "^2.1.9",
    "@rsbuild/plugin-react": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.0.0",
    "eslint-plugin-format": "^1.4.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
